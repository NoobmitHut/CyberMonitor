<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CyberMonitor</AssemblyName>
    <RootNamespace>CyberMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Wird beim Release-Build aus dem Git-Tag gesetzt (v1.2.3 → 1.2.3) -->
    <Version>1.0.1</Version>

    <!-- Schlanker Laufzeit-Footprint: keine zusätzlichen GC-Hintergrundthreads -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- WFAC010: WinForms möchte DPI per API statt im Manifest. Das Fenster ist aber WPF, dort ist das Manifest richtig
         (PerMonitorV2); WinForms wird nur fürs Tray-Icon benutzt. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Feste Versionen: Release-Builds sollen genau das enthalten, was getestet wurde (siehe THIRD-PARTY-NOTICES.md) -->
    <!-- Sensoren: CPU/GPU Last, Temperatur, Takt, Leistung (braucht für CPU-Werte den Treiber PawnIO) -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- FPS: Present-Events per ETW (gleiches Prinzip wie PresentMon) -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.30" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deinstallations-Kit, Anleitung und Lizenzhinweise: landen neben der EXE (bin\ und publish\) -->
    <None Update="Uninstall.ps1;Uninstall.bat;README.md;THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Nur zum Anschauen im Browser, gehört nicht ins Programm -->
    <None Update="Vorschau.html" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
